# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Cloud LLM (needed from Week 2 onward for extraction/classification/reasoning).
# Not required for the Week 1 deterministic substrate.
# Setu reads this project-local value directly and does not inherit a global shell key.
# The client is pinned to https://api.anthropic.com; proxy/corporate endpoints are rejected.
ANTHROPIC_API_KEY=

# Local model (Ollama) — optional, used from Week 2 for PII-heavy extraction.
# OLLAMA_HOST=http://localhost:11434
